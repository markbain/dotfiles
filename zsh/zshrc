export ZSH=$HOME/.oh-my-zsh

# Set name of the theme to load.
# Look in ~/.oh-my-zsh/themes/
# Optionally, if you set this to "random", it'll load a random theme each
# time that oh-my-zsh is loaded.
ZSH_THEME="random"

plugins=(git git-flow-completion nvm)

# User configuration

export PATH=$HOME/bin:/usr/local/bin:$PATH
# export MANPATH="/usr/local/man:$MANPATH"

source $ZSH/oh-my-zsh.sh

# Toggle between full agnoster prompt and a short prompt
toggle_prompt() {
  if [[ "$ZSH_THEME" == "agnoster" ]]; then
    ZSH_THEME="minimal"
    source $ZSH/oh-my-zsh.sh
  else
    ZSH_THEME="agnoster"
    source $ZSH/oh-my-zsh.sh
  fi
}
alias tp='toggle_prompt'

# NVM Bash Completion
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/bain/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/bain/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/bain/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/bain/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.config/composer/vendor/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.fzf/bin:$PATH"

# zoxide — frecency-based cd
eval "$(zoxide init zsh)"

# proj — fuzzy jump to a project
proj() {
  local target=$(find -L ~/code ~/dropbox -maxdepth 10 -mindepth 1 \
    \( -name "node_modules" -o -name ".git" -o -name "vendor" -o -name "__pycache__" \
       -o -name "dist" -o -name "build" -o -name ".cache" -o -name ".claude" \
       -o -name ".vscode" -o -name ".idea" -o -name "*.xcassets" \) -prune \
    -o -type d -print 2>/dev/null | fzf --prompt="Project: ")
  [[ -n "$target" ]] && cd "$target"
}
[ -f "$HOME/.dotfiles/secrets/env" ] && source "$HOME/.dotfiles/secrets/env"

# ── Studio project recap prompt ──────────────────────────────────────────────
# When cd-ing into a registered project directory, prompt for a recap.
_studio_projects_json="/media/data/dev/bain-studio/studio/projects.json"

function _studio_recap_prompt() {
  [[ -f "$_studio_projects_json" ]] || return
  local paths
  paths=$(python3 -c "
import json
data = json.load(open('$_studio_projects_json'))
for p in data:
    print(p['path'])
" 2>/dev/null)
  echo "$paths" | grep -qxF "$PWD" || return
  # Only prompt in interactive shells, not in subshells
  [[ -o interactive ]] || return
  echo -n "[studio] Want a recap? [y/N] "
  read -r -k 1 _recap_answer
  echo
  if [[ "$_recap_answer" =~ ^[Yy]$ ]]; then
    claude /recap
  fi
}

autoload -U add-zsh-hook
add-zsh-hook chpwd _studio_recap_prompt
